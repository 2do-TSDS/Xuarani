<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>Año</th>
      <th>Inicio</th>
      <th>Final</th>
      <th class="text-end">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% ciclo_lectivos.each do |ciclo| %>
      <tr>
        <td><%= ciclo.id %></td>
        <td><%= ciclo.año %></td>
        <td><%= l(ciclo.inicio, format: :short) if ciclo.inicio.present? %></td>
        <td><%= l(ciclo.final, format: :short) if ciclo.final.present? %></td>
        <td class="text-end">
          <!-- <%= link_to "Ver", ciclo, class: "btn btn-sm btn-outline-secondary" %> -->
          <% if can?(:update, ciclo) %>
            <%= link_to "Editar", edit_ciclo_lectivo_path(ciclo), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
          <% if can?(:destroy, ciclo) %>
          <button type="button"
                  class="btn btn-sm btn-outline-danger"
                  data-bs-toggle="modal"
                  data-bs-target="#confirmDeleteCicloModal"
                  data-action-url="<%= ciclo_lectivo_path(ciclo, from: 'organizacion') %>"
                  data-ciclo-label="Ciclo <%= ciclo.año %>">
            Eliminar
          </button>
        <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="modal fade" id="confirmDeleteCicloModal" tabindex="-1" aria-labelledby="confirmDeleteCicloModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="confirmDeleteCicloModalLabel">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar eliminación
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        ¿Seguro que deseas eliminar <strong id="cicloToDelete"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

        <form id="deleteCicloForm" method="post">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" id="csrfCicloToken">
          <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("confirmDeleteCicloModal");
    const label = document.getElementById("cicloToDelete");
    const form  = document.getElementById("deleteCicloForm");
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");
    document.getElementById("csrfCicloToken").value = csrfToken;

    modal.addEventListener("show.bs.modal", (event) => {
      const btn = event.relatedTarget;
      const actionUrl = btn.getAttribute("data-action-url");
      const cicloText = btn.getAttribute("data-ciclo-label") || "este ciclo lectivo";

      label.textContent = cicloText;
      form.action = actionUrl; // ej: /ciclo_lectivos/3?from=organizacion
    });
  });
</script>
