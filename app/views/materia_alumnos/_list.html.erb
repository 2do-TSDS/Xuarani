<div class="top-pagination">
  <%= page_entries_info @materia_alumnos %>
  <%= paginate @materia_alumnos %>
</div>
<table class="table table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Materia / División</th>
      <th>Alumno</th>
    </tr>
  </thead>
  <tbody>
    <% materia_alumnos.each do |malum| %>
      <tr>
        <td><%= malum.materia_division.display_name %></td>
        <td><%= malum.alumno.display_name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<div class="bottom-pagination">
  <%= paginate @materia_alumnos%>
</div>