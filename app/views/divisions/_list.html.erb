<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>Nombre</th>
      <th class="text-end">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% divisions.each do |d| %>
      <tr id="<%= dom_id(d) %>">
        <td><%= d.id %></td>
        <td><%= d.try(:nombre) || d.try(:name) || d.try(:descripcion) %></td>
        <td class="text-end">
          <!-- <%= link_to "Ver", d, class: "btn btn-sm btn-outline-secondary" %> -->
          <% if can?(:update, d) %>
            <%= link_to "Editar", edit_division_path(d), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
          <% if can?(:destroy, d) %>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#confirmDeleteDivisionModal"
                    data-action-url="<%= division_path(d, from: 'organizacion') %>"
                    data-division-label="<%= d.try(:nombre) || d.try(:name) || d.try(:descripcion) || 'esta división' %>">
              Eliminar
            </button>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="modal fade" id="confirmDeleteDivisionModal" tabindex="-1" aria-labelledby="confirmDeleteDivisionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="confirmDeleteDivisionModalLabel">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar eliminación
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        ¿Seguro que deseas eliminar <strong id="divisionToDelete"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

        <form id="deleteDivisionForm" method="post">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" id="csrfDivisionToken">
          <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("confirmDeleteDivisionModal");
    const label = document.getElementById("divisionToDelete");
    const form  = document.getElementById("deleteDivisionForm");
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");
    document.getElementById("csrfDivisionToken").value = csrfToken;

    modal.addEventListener("show.bs.modal", (event) => {
      const btn = event.relatedTarget;
      const actionUrl = btn.getAttribute("data-action-url");
      const divisionText = btn.getAttribute("data-division-label") || "esta división";

      label.textContent = divisionText;
      form.action = actionUrl; // ej: /divisions/5?from=organizacion
    });
  });
</script>
